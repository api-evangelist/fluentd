      "item": [
        {
          "id": "bdcc7bdb-3bf9-4e87-86b2-96b3385e3b72",
          "name": "Fluentd Post a log event",
          "request": {
            "name": "Fluentd Post a log event",
            "description": {
              "content": "Posts a single log event to Fluentd with the specified tag. The tag determines which Fluentd match rules route the event downstream. The request body can be JSON, MessagePack, or form-encoded. When sending JSON, the Content-Type must be application/json. The time field can be supplied in the body or omitted to use the server receive time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":tag"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "tag",
                  "description": "(Required) The Fluentd tag for this event. Tags use dot-separated hierarchical notation (e.g., myapp.access, production.web.error) and are used by match directives to route events to outputs."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "method": "POST",
            "auth": null,
